    {
      "@type": "HowTo",
      "@id": "{{SITE_BASE}}/chto-on-skryvaet-v-otnosheniyah-i-skazhet-li-pravdu/#howto",
      "name": "Практика: чеклист шагов для утренней ясности",
      "description": "Чтобы утренняя тревога не переросла в разрушительную ссору, полезно опираться на простые шаги бережного общения.",
      "inLanguage": "ru-RU",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Отделить факты от догадок",
          "text": "Зафиксировать реальные слова и поступки, не достраивая в мыслях пугающие картины без оснований."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Использовать нейтральное я-сообщение",
          "text": "Сказать о своих ощущениях («мне тревожно, когда вчера разговор обрывается, а утром повисает тишина»), избегая обвинений и допроса."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Различать право на личные границы и скрытность в общих делах",
          "text": "Личные переживания требуют времени, а вопросы совместных планов и договорённостей требуют ясного обсуждения."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Дать пространство для ответа",
          "text": "Отказаться от частых сообщений, если видно, что собеседник напряжён, и дать возможность вернуться к теме спокойно."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Оценить встречный шаг",
          "text": "Обратить внимание на готовность слушать и идти на контакт, когда снято внешнее давление."
        }
      ]
    }
