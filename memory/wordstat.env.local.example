# Wordstat / Yandex Cloud Search API v2 — LOCAL SECRET SLOT
#
# Copy this file to memory/wordstat.env.local and paste the key.
# memory/wordstat.env.local is gitignored. Do not commit the copy.
# Do not paste the key into chat, PR, tenant-config, or handoff.
#
# Cloud: same names in Cursor → Cloud Agents → Secrets (Runtime Secret).
# folder_id is Cloud Secret YANDEX_FOLDER_ID — never commit the value.

YANDEX_CLOUD_SEARCH_API_KEY=

# Public in Yandex console, treated as Cloud Secret here.
YANDEX_FOLDER_ID=
